-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local MaxDistance = 12000.5

-- Toggle
local ESPEnabled = true

-- Setup Nametag
local function SetupNametag(Player, Character)
    local Head = Character:WaitForChild("Head", 5)
    if not Head then return end

    -- Remove old
    local Old = Head:FindFirstChild("Nametag")
    if Old then Old:Destroy() end

    local BillboardGui = Instance.new("BillboardGui")
    BillboardGui.Name = "Nametag"
    BillboardGui.Adornee = Head
    BillboardGui.Size = UDim2.new(0, 75, 0, 150)
    BillboardGui.StudsOffset = Vector3.new(0, 2, 0)
    BillboardGui.AlwaysOnTop = true

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Size = UDim2.new(1, 0, 1, 0)
    TextLabel.Text = Player.Name
    TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextLabel.BackgroundTransparency = 1
    TextLabel.TextStrokeTransparency = 0.75
    TextLabel.Font = Enum.Font.Code
    TextLabel.TextScaled = true
    TextLabel.Parent = BillboardGui

    BillboardGui.Parent = Head

    -- Update visibility
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not Character.Parent or not Head.Parent then
            if conn then conn:Disconnect() end
            if BillboardGui then BillboardGui:Destroy() end
            return
        end

        if ESPEnabled
            and LocalPlayer.Character
            and LocalPlayer.Character:FindFirstChild("Head") then
            local Distance = (Head.Position - LocalPlayer.Character.Head.Position).Magnitude
            BillboardGui.Enabled = (Distance <= MaxDistance)
        else
            BillboardGui.Enabled = false
        end
    end)

    -- Hide on death
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        Humanoid.Died:Connect(function()
            if BillboardGui then BillboardGui:Destroy() end
        end)
    end
end

-- Setup Highlight
local function SetupHighlight(Player, Character)
    for _, v in pairs(Character:GetChildren()) do
        if v:IsA("Highlight") then v:Destroy() end
    end

    local HL = Instance.new("Highlight")
    HL.Name = "ESP_Highlight"
    HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    HL.FillTransparency = 0.5
    HL.OutlineTransparency = 0
    HL.Parent = Character

    local function UpdateColor()
        local Default = Color3.fromRGB(255, 48, 51)
        HL.FillColor = Player.TeamColor and Player.TeamColor.Color or Default
    end

    UpdateColor()
    Player:GetPropertyChangedSignal("TeamColor"):Connect(UpdateColor)

    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    if Humanoid then
        Humanoid.Died:Connect(function()
            if HL then HL:Destroy() end
        end)
    end
end

-- Attach ESP to a player
local function AttachESP(Player)
    if Player == LocalPlayer then return end

    local function Setup(Character)
        if not Character then return end
        SetupNametag(Player, Character)
        SetupHighlight(Player, Character)
    end

    -- Respawn
    Player.CharacterAdded:Connect(Setup)

    -- First spawn
    if Player.Character then Setup(Player.Character) end

    -- 🔥 Cleanup when player leaves
    Player.AncestryChanged:Connect(function(_, parent)
        if not parent then
            if Player.Character then
                if Player.Character:FindFirstChild("Head") then
                    local tag = Player.Character.Head:FindFirstChild("Nametag")
                    if tag then tag:Destroy() end
                end
                local hl = Player.Character:FindFirstChild("ESP_Highlight")
                if hl then hl:Destroy() end
            end
        end
    end)
end

-- Toggle ESP
local function ToggleESP()
    ESPEnabled = not ESPEnabled
    print("ESP Enabled:", ESPEnabled)

    for _, Player in pairs(Players:GetPlayers()) do
        if Player ~= LocalPlayer and Player.Character then
            if Player.Character:FindFirstChild("Head") then
                local Tag = Player.Character.Head:FindFirstChild("Nametag")
                if Tag then Tag.Enabled = ESPEnabled end
            end
            local HL = Player.Character:FindFirstChild("ESP_Highlight")
            if HL then HL.Enabled = ESPEnabled end
        end
    end
end

-- Keybind
UserInputService.InputBegan:Connect(function(Input, Processed)
    if not Processed and Input.KeyCode == Enum.KeyCode.LeftBracket then
        ToggleESP()
    end
end)

-- Setup for all players
for _, p in pairs(Players:GetPlayers()) do
    AttachESP(p)
end
Players.PlayerAdded:Connect(AttachESP)
